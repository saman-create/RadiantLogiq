{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/$", "dest": "/index.html", "headers": { "Cache-Control": "no-cache, max-age=0, must-revalidate" } },
    { "src": "^/(pricing|about|partners|blog|contact|demo|login|privacy|terms|hipaa|security)/?$", "dest": "/$1/index.html", "headers": { "Cache-Control": "no-cache, max-age=0, must-revalidate" } },
    { "src": "^/products/(telehealth|pacs|cds|ehr|meds)/?$", "dest": "/products/$1/index.html", "headers": { "Cache-Control": "no-cache, max-age=0, must-revalidate" } },
    { "handle": "filesystem" },
    { "src": "^/.*$", "dest": "/404.html", "status": 404 }
  ]
}
